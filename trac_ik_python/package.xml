<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>trac_ik_python</name>
  <version>2.0.0</version>
  <description>The trac_ik_python package contains a python wrapper using SWIG
  for trac_ik_lib (ROS 2 port)</description>
  <author>Sam Pfeiffer</author>
  <maintainer email="robotics@traclabs.com">TRACLabs Robotics</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <build_depend>swig</build_depend>

  <depend>trac_ik_lib</depend>
  <depend>kdl_parser</depend>
  <depend>urdf</depend>
  <depend>rclcpp</depend>
  <depend>libnlopt-cxx-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
